<?xml version="1.0" encoding="utf-8"?>
<!--
    Thin-window rebuild (XEN-481). The plugin stores nothing canonical
    locally — pricing, gating, per-bot overrides and the payout wallet all
    live on the platform and are managed in dash.xenarch.dev. The only
    persisted component params are the pairing credentials + the
    browser-proof HMAC secret, plus a couple of behaviour fallbacks the gate
    reads when the platform is unreachable.
-->
<config>
    <fieldset name="xenarch" label="Xenarch Settings">
        <field name="site_id" type="text" label="Site ID" default="" readonly="true" />
        <field name="site_token" type="text" label="Site Token" default="" readonly="true" />
        <field name="browser_proof_secret" type="text" label="Browser Proof Secret" default="" readonly="true" />
        <field name="gate_enabled" type="list" label="Gate Enabled (outage fallback)" default="1">
            <option value="1">Yes</option>
            <option value="0">No</option>
        </field>
        <field name="gate_unknown_traffic" type="list" label="Gate Unknown Traffic" default="1">
            <option value="1">Yes</option>
            <option value="0">No</option>
        </field>
    </fieldset>
</config>
